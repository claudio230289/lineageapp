<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Control Financiero - Claudio (v10)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js para Gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <meta name="theme-color" content="#4f46e5">
    <link rel="manifest" href="./manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Finanzas">

    <style>
        body { background-color: #f3f4f6; font-family: system-ui, -apple-system, sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        @media print {
            body { background: white; }
            nav, header button, .no-print { display: none !important; }
            .tab-content { display: block !important; }
        }
    </style>
</head>
<body class="text-gray-800 pb-24">

    <!-- Header & Dólar / Respaldo -->
    <header class="bg-indigo-700 text-white p-4 shadow-md sticky top-0 z-50">
        <div class="flex justify-between items-center max-w-md mx-auto">
            <div>
                <h1 class="text-base font-bold">Mis Finanzas v10</h1>
                <p class="text-[11px] text-indigo-200" id="current-date-label">Cargando fecha...</p>
            </div>
            
            <div class="flex items-center space-x-2">
                <!-- Dólar -->
                <div onclick="editarDolarManual()" class="bg-indigo-800 px-3 py-1.5 rounded-lg text-right border border-indigo-600 cursor-pointer hover:bg-indigo-900 transition flex items-center space-x-2">
                    <div>
                        <span class="text-[9px] uppercase tracking-wider text-indigo-300 block">Dólar Oficial</span>
                        <span class="text-xs font-bold" id="dolar-oficial-val">$ 1.250</span>
                    </div>
                    <i class="fa-solid fa-pen text-[9px] text-indigo-300"></i>
                </div>
            </div>
        </div>
        <!-- Controles de Respaldo y Acciones Globales -->
        <div class="flex justify-center space-x-2 max-w-md mx-auto mt-2 pt-2 border-t border-indigo-600/50 flex-wrap gap-y-1">
            <button onclick="guardarYDescargarRespaldo()" class="text-[10px] bg-emerald-600 text-white px-2.5 py-1 rounded border border-emerald-500 hover:bg-emerald-700 transition flex items-center">
                <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar & JSON
            </button>
            <label class="text-[10px] bg-indigo-800 text-indigo-200 px-2.5 py-1 rounded border border-indigo-600 hover:bg-indigo-900 transition cursor-pointer flex items-center">
                <i class="fa-solid fa-upload mr-1"></i> Cargar JSON
                <input type="file" id="import-file" accept=".json,text/plain,application/octet-stream" onchange="importarRespaldoJSON(event)" class="hidden">
            </label>
            <button onclick="window.print()" class="text-[10px] bg-indigo-800 text-indigo-200 px-2 py-1 rounded border border-indigo-600 hover:bg-indigo-900 transition flex items-center">
                <i class="fa-solid fa-file-pdf mr-1"></i> PDF
            </button>
            <button onclick="enviarReporteWhatsApp()" class="text-[10px] bg-green-700 text-white px-2 py-1 rounded border border-green-600 hover:bg-green-800 transition flex items-center">
                <i class="fa-brands fa-whatsapp mr-1"></i> WhatsApp
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto p-4">

        <!-- Selector de Mes Global (2026 - 2028) -->
        <div class="bg-white p-3 rounded-xl shadow-sm mb-4 flex items-center justify-between">
            <label for="global-month" class="text-sm font-medium text-gray-600"><i class="fa-regular fa-calendar-days mr-1 text-indigo-600"></i> Mes a analizar:</label>
            <select id="global-month" onchange="cambiarMesGlobal()" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 p-2 font-medium">
                <optgroup label="2026">
                    <option value="2026-01">Enero 2026</option>
                    <option value="2026-02">Febrero 2026</option>
                    <option value="2026-03">Marzo 2026</option>
                    <option value="2026-04">Abril 2026</option>
                    <option value="2026-05">Mayo 2026</option>
                    <option value="2026-06">Junio 2026</option>
                    <option value="2026-07">Julio 2026</option>
                    <option value="2026-08">Agosto 2026</option>
                    <option value="2026-09">Septiembre 2026</option>
                    <option value="2026-10">Octubre 2026</option>
                    <option value="2026-11">Noviembre 2026</option>
                    <option value="2026-12">Diciembre 2026</option>
                </optgroup>
                <optgroup label="2027">
                    <option value="2027-01">Enero 2027</option>
                    <option value="2027-02">Febrero 2027</option>
                    <option value="2027-03">Marzo 2027</option>
                    <option value="2027-04">Abril 2027</option>
                    <option value="2027-05">Mayo 2027</option>
                    <option value="2027-06">Junio 2027</option>
                    <option value="2027-07">Julio 2027</option>
                    <option value="2027-08">Agosto 2027</option>
                    <option value="2027-09">Septiembre 2027</option>
                    <option value="2027-10">Octubre 2027</option>
                    <option value="2027-11">Noviembre 2027</option>
                    <option value="2027-12">Diciembre 2027</option>
                </optgroup>
                <optgroup label="2028">
                    <option value="2028-01">Enero 2028</option>
                    <option value="2028-02">Febrero 2028</option>
                    <option value="2028-03">Marzo 2028</option>
                    <option value="2028-04">Abril 2028</option>
                    <option value="2028-05">Mayo 2028</option>
                    <option value="2028-06">Junio 2028</option>
                    <option value="2028-07">Julio 2028</option>
                    <option value="2028-08">Agosto 2028</option>
                    <option value="2028-09">Septiembre 2028</option>
                    <option value="2028-10">Octubre 2028</option>
                    <option value="2028-11">Noviembre 2028</option>
                    <option value="2028-12">Diciembre 2028</option>
                </optgroup>
            </select>
        </div>

        <div id="tab-resumen" class="tab-content active space-y-4">
            <div class="bg-gradient-to-br from-indigo-600 to-indigo-800 text-white p-5 rounded-2xl shadow-lg relative overflow-hidden">
                <div class="absolute -right-4 -bottom-4 text-white opacity-10 text-8xl">
                    <i class="fa-solid fa-wallet"></i>
                </div>
                <p class="text-xs uppercase tracking-wider text-indigo-200 font-medium">Sueldo Disponible (Neto - Pagos)</p>
                <h2 class="text-3xl font-bold mt-1" id="card-saldo-disponible-pagado">$ 0,00</h2>
                <div class="mt-2 text-xs text-indigo-200 flex justify-between">
                    <span>Neto Teórico: <strong id="card-sueldo-neto-teorico" class="text-white">$ 0,00</strong></span>
                </div>
                <div class="grid grid-cols-2 gap-3 mt-4 pt-4 border-t border-indigo-500/40">
                    <div>
                        <span class="text-[11px] text-indigo-200 block">Total Egresos (Mes)</span>
                        <span class="text-base font-semibold" id="card-total-egresos">$ 0,00</span>
                    </div>
                    <div>
                        <span class="text-[11px] text-indigo-200 block">Gastos Pendientes</span>
                        <span class="text-base font-semibold" id="card-gastos-pendientes">$ 0,00</span>
                    </div>
                </div>
            </div>

            <!-- Botón Único Limpio para Enviar JSON por WhatsApp -->
            <div class="bg-white p-3 rounded-2xl shadow-sm">
                <button onclick="compartirArchivoBackupWhatsApp()" class="w-full bg-green-600 hover:bg-green-700 text-white text-xs font-medium py-3 px-4 rounded-xl flex items-center justify-center transition shadow-sm">
                    <i class="fa-brands fa-whatsapp mr-2 text-base"></i> Enviar JSON de Respaldo por WhatsApp
                </button>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm">
                <h3 class="text-sm font-bold text-gray-700 mb-3 flex items-center">
                    <i class="fa-solid fa-chart-pie mr-2 text-indigo-600"></i> Desglose de Gastos del Mes
                </h3>
                <div class="grid grid-cols-2 gap-2 text-center">
                    <div class="bg-orange-50 p-3 rounded-xl border border-orange-100">
                        <span class="text-[10px] font-bold text-orange-700 uppercase block">Gastos Fijos</span>
                        <span class="text-xs font-bold text-orange-900 mt-1 block" id="summary-col-fijos">$ 0,00</span>
                    </div>
                    <div class="bg-red-50 p-3 rounded-xl border border-red-100">
                        <span class="text-[10px] font-bold text-red-700 uppercase block">Deudas</span>
                        <span class="text-xs font-bold text-red-900 mt-1 block" id="summary-col-deudas">$ 0,00</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-ingresos" class="tab-content space-y-4">
            <div class="bg-blue-50 border border-blue-200 p-3.5 rounded-2xl text-xs text-blue-900 space-y-1.5 shadow-sm">
                <p class="font-bold flex items-center text-blue-900"><i class="fa-solid fa-circle-info mr-1.5 text-blue-600"></i> Instructivo: Carga de Recibo de Sueldo</p>
                <p>1. Seleccioná el mes correspondiente arriba.</p>
                <p>2. Cargá primero el <strong>Sueldo Básico</strong> (obligatorio para calcular porcentajes).</p>
                <p>3. Agregá conceptos adicionales con nombre único.</p>
            </div>

            <div class="bg-white p-4 rounded-2xl shadow-sm border border-indigo-100 bg-gradient-to-r from-indigo-50 to-blue-50">
                <h3 class="text-xs font-bold text-indigo-800 uppercase tracking-wider mb-2"><i class="fa-solid fa-file-invoice-dollar mr-1"></i> Resumen de Recibo del Mes</h3>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="bg-white p-2.5 rounded-xl border border-indigo-100 shadow-sm">
                        <span class="text-gray-500 block text-[10px]">Total Remunerativo</span>
                        <span class="font-mono font-bold text-indigo-900 text-sm" id="recibo-tot-rem">$ 0,00</span>
                    </div>
                    <div class="bg-white p-2.5 rounded-xl border border-indigo-100 shadow-sm">
                        <span class="text-gray-500 block text-[10px]">Total No Remun.</span>
                        <span class="font-mono font-bold text-indigo-900 text-sm" id="recibo-tot-norem">$ 0,00</span>
                    </div>
                    <div class="bg-white p-2.5 rounded-xl border border-indigo-100 shadow-sm">
                        <span class="text-gray-500 block text-[10px]">Total Deducciones (-)</span>
                        <span class="font-mono font-bold text-red-600 text-sm" id="recibo-tot-ded">$ 0,00</span>
                    </div>
                    <div class="bg-indigo-600 p-2.5 rounded-xl text-white shadow-sm">
                        <span class="text-indigo-200 block text-[10px]">NETO A COBRAR</span>
                        <span class="font-mono font-bold text-white text-sm" id="recibo-neto-final">$ 0,00</span>
                    </div>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-sm font-bold text-gray-800"><i class="fa-solid fa-plus-circle mr-1 text-indigo-600"></i> Agregar Concepto</h3>
                    <button onclick="replicarIngresosMes()" class="text-[11px] bg-indigo-50 text-indigo-700 font-medium px-2.5 py-1.5 rounded-lg border border-indigo-200">
                        <i class="fa-solid fa-copy mr-1"></i> Replicar Futuros
                    </button>
                </div>
                <form id="form-ingreso" onsubmit="guardarIngreso(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Concepto / Detalle (Nombre Único)</label>
                        <input type="text" id="ing-concepto" required placeholder="Ej. Sueldo Básico" class="w-full text-sm border border-gray-300 rounded-lg p-2">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Tipo</label>
                            <select id="ing-tipo" class="w-full text-sm border border-gray-300 rounded-lg p-2 bg-white" onchange="toggleTipoIngreso()">
                                <option value="Basico">Sueldo Básico</option>
                                <option value="Remunerativo">Remunerativo (+)</option>
                                <option value="NoRemunerativo">No Remunerativo (+)</option>
                                <option value="Deduccion">Deducción (-)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Modo de Monto</label>
                            <select id="ing-modo-monto" class="w-full text-sm border border-gray-300 rounded-lg p-2 bg-white" onchange="toggleModoMonto()">
                                <option value="importe">Importe Fijo ($)</option>
                                <option value="porcentaje" id="opt-porcentaje" disabled>% del Básico</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1" id="label-valor-monto">Monto ($)</label>
                        <input type="number" step="0.01" id="ing-valor" required placeholder="0.00" class="w-full text-sm border border-gray-300 rounded-lg p-2 font-mono">
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 text-white text-sm font-medium py-2 rounded-lg shadow-sm hover:bg-indigo-700">Agregar Concepto</button>
                </form>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm">
                <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Detalle del Recibo</h4>
                <div id="lista-ingresos" class="space-y-2"></div>
            </div>
        </div>

        <div id="tab-gastos" class="tab-content space-y-4">
            <div class="bg-orange-50 border border-orange-200 p-3.5 rounded-2xl text-xs text-orange-900 space-y-1.5 shadow-sm">
                <p class="font-bold flex items-center text-orange-900"><i class="fa-solid fa-circle-info mr-1.5 text-orange-600"></i> Instructivo: Gastos Fijos Automáticos</p>
                <p>• <strong>Gastos Fijos:</strong> Se replican <strong>automáticamente</strong> a todos los meses futuros (2026-2028) al ser creados o modificados.</p>
                <p>• <strong>Buscador / Filtro:</strong> Al filtrar (ej. "Tarjeta"), WhatsApp enviará exclusivamente el detalle filtrado sin exponer ingresos ni saldo global.</p>
            </div>
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-indigo-100 flex items-center space-x-2">
                <i class="fa-solid fa-filter text-indigo-600 ml-1"></i>
                <input type="text" id="filtro-gastos" oninput="renderizarTodo()" placeholder="Filtrar por concepto (ej. Tarjeta)..." class="w-full text-xs border border-gray-200 rounded-lg p-2">
                <span id="filtro-total-badge" class="text-[10px] font-bold bg-indigo-100 text-indigo-800 px-2 py-1.5 rounded-lg whitespace-nowrap">Total: $0</span>
            </div>
            <div class="bg-white p-3 rounded-2xl shadow-sm border border-amber-200 bg-amber-50 flex justify-between items-center">
                <div>
                    <span class="text-xs font-bold text-amber-900 block">Arrastrar Deudas Pendientes</span>
                    <span class="text-[10px] text-amber-700">Migra lo pendiente al mes siguiente con trazabilidad.</span>
                </div>
                <button onclick="ejecutarRollOverDeudas()" class="text-xs bg-amber-600 hover:bg-amber-700 text-white font-medium px-3 py-2 rounded-xl shadow-sm transition">
                    <i class="fa-solid fa-share-from-square mr-1"></i> Roll-over
                </button>
            </div>
            <div class="bg-gradient-to-r from-indigo-700 to-indigo-900 text-white p-4 rounded-2xl shadow-md flex justify-between items-center">
                <div>
                    <span class="text-[10px] uppercase tracking-wider text-indigo-200 block font-medium">Disponible (Neto - Pagos)</span>
                    <span class="text-2xl font-bold font-mono" id="gastos-saldo-disponible">$ 0,00</span>
                </div>
                <div class="text-right">
                    <span class="text-[10px] text-indigo-200 block">Sueldo Neto</span>
                    <span class="text-sm font-semibold font-mono" id="gastos-sueldo-neto">$ 0,00</span>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200">
                <h3 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2"><i class="fa-solid fa-calculator mr-1 text-indigo-600"></i> Resumen <span id="label-resumen-modo" class="text-indigo-700"></span></h3>
                <div class="grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="bg-gray-50 p-2.5 rounded-xl border border-gray-100">
                        <span class="text-gray-500 block text-[10px]">Total Gastos</span>
                        <span class="font-mono font-bold text-gray-900 text-sm" id="gastos-tot-general">$ 0,00</span>
                    </div>
                    <div class="bg-emerald-50 p-2.5 rounded-xl border border-emerald-100">
                        <span class="text-emerald-700 block text-[10px]">Pagado</span>
                        <span class="font-mono font-bold text-emerald-900 text-sm" id="gastos-tot-pagado">$ 0,00</span>
                    </div>
                    <div class="bg-orange-50 p-2.5 rounded-xl border border-orange-100">
                        <span class="text-orange-700 block text-[10px]">Pendiente</span>
                        <span class="font-mono font-bold text-orange-900 text-sm" id="gastos-tot-pendiente">$ 0,00</span>
                    </div>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-sm font-bold text-gray-800"><i class="fa-solid fa-credit-card mr-1 text-indigo-600"></i> <span id="form-gasto-titulo">Cargar Gasto</span></h3>
                </div>
                <form id="form-gasto" onsubmit="guardarGasto(event)" class="space-y-3">
                    <input type="hidden" id="gas-edit-id" value="">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Descripción / Concepto (Ej. Deuda a Tarjeta)</label>
                        <input type="text" id="gas-concepto" required placeholder="Ej. Deuda a Tarjeta" class="w-full text-sm border border-gray-300 rounded-lg p-2">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Categoría</label>
                            <select id="gas-categoria" class="w-full text-sm border border-gray-300 rounded-lg p-2 bg-white">
                                <option value="Fijos">Gastos Fijos</option>
                                <option value="Deudas">Deudas / Cuotas</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Monto ($)</label>
                            <input type="number" step="0.01" id="gas-monto" required placeholder="0.00" class="w-full text-sm border border-gray-300 rounded-lg p-2 font-mono">
                        </div>
                    </div>
                    <div class="flex space-x-2">
                        <button type="submit" id="btn-submit-gasto" class="w-full bg-indigo-600 text-white text-sm font-medium py-2 rounded-lg shadow-sm hover:bg-indigo-700">Agregar Gasto</button>
                        <button type="button" id="btn-cancel-edit" onclick="cancelarEdicionGasto()" class="hidden bg-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg">Cancelar</button>
                    </div>
                </form>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-purple-100 bg-gradient-to-r from-purple-50 to-indigo-50">
                <h3 class="text-xs font-bold text-purple-800 uppercase tracking-wider mb-2"><i class="fa-solid fa-receipt mr-1"></i> Cargar Tarjeta / Compra en Cuotas</h3>
                <form id="form-tarjeta" onsubmit="guardarCompraTarjeta(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Descripción</label>
                        <input type="text" id="tar-concepto" required placeholder="Ej. Compra Cuotas" class="w-full text-sm border border-gray-300 rounded-lg p-2">
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Cuota Inicio</label>
                            <input type="number" min="1" id="tar-cuota-inicio" value="1" required class="w-full text-sm border border-gray-300 rounded-lg p-2 font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Total Cuotas</label>
                            <input type="number" min="1" max="60" id="tar-cuotas" required placeholder="Ej. 12" class="w-full text-sm border border-gray-300 rounded-lg p-2 font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Importe ($)</label>
                            <input type="number" step="0.01" id="tar-monto" required placeholder="0.00" class="w-full text-sm border border-gray-300 rounded-lg p-2 font-mono">
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-purple-600 text-white text-sm font-medium py-2 rounded-lg shadow-sm hover:bg-purple-700">Generar Cuotas</button>
                </form>
            </div>
            <div class="space-y-4">
                <div class="bg-white p-4 rounded-2xl shadow-sm border-l-4 border-orange-500">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="text-xs font-bold text-orange-700 uppercase">Gastos Fijos</h4>
                        <span class="text-xs font-bold text-gray-700" id="total-col-fijos">$ 0,00</span>
                    </div>
                    <div id="lista-gastos-fijos" class="space-y-2"></div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border-l-4 border-red-500">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="text-xs font-bold text-red-700 uppercase">Deudas / Cuotas</h4>
                        <span class="text-xs font-bold text-gray-700" id="total-col-deudas">$ 0,00</span>
                    </div>
                    <div id="lista-gastos-deudas" class="space-y-2"></div>
                </div>
            </div>
        </div>

        <div id="tab-deseos" class="tab-content space-y-4">
            <div class="bg-emerald-50 border border-emerald-200 p-3.5 rounded-2xl text-xs text-emerald-900 space-y-1.5 shadow-sm">
                <p class="font-bold flex items-center text-emerald-900"><i class="fa-solid fa-circle-info mr-1.5 text-emerald-600"></i> Instructivo: Lista de Deseos</p>
                <p>Evaluación automática en base a tu saldo disponible actual.</p>
            </div>
            <div class="bg-indigo-50 border border-indigo-200 p-4 rounded-2xl text-xs text-indigo-900 space-y-2 shadow-sm">
